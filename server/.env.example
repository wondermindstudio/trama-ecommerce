# Copiá este archivo a .env y completá los valores. Nunca subas .env a Git.
NODE_ENV=development
PORT=4000

# MongoDB local (docker compose up -d) o MongoDB Atlas
MONGODB_URI=mongodb://localhost:27017/trama

# Generá uno con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambiame-por-un-secreto-largo-de-al-menos-32-caracteres
JWT_EXPIRES_IN=7d

# URL del frontend (CORS y redirecciones de pago) y URL pública de esta API
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:4000

# Pagos: "mock" funciona sin credenciales (ideal para portfolio). "mercadopago" usa Checkout Pro.
PAYMENT_PROVIDER=mock
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# Contraseña del usuario admin que crea `npm run seed` (solo desarrollo)
SEED_ADMIN_PASSWORD=Admin1234!
