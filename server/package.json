{
  "name": "trama-server",
  "version": "1.0.0",
  "private": true,
  "description": "API REST de Trama: autenticación, catálogo, carrito con promociones, pedidos y pagos.",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20.6"
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
